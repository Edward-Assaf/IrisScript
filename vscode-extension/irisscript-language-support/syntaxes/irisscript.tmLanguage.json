{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "IrisScript",
    "scopeName": "source.iris",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#types"
        },
        {
            "include": "#booleans"
        },
        {
            "include": "#function-declarations"
        },
        {
            "include": "#function-calls"
        },
        {
            "include": "#variable-declarations"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.iris",
                    "match": "//.*$"
                },
                {
                    "name": "comment.block.iris",
                    "begin": "/\\*",
                    "end": "\\*/"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.iris",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.iris",
                    "match": "\\\\[ntr\\\\\"]"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.decimal.iris",
                    "match": "\\b[0-9]+\\.[0-9]+\\b"
                },
                {
                    "name": "constant.numeric.integer.iris",
                    "match": "\\b[0-9]+\\b"
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.iris",
                    "match": "\\b(if|else|elseif|while|break|skip|return)\\b"
                },
                {
                    "name": "keyword.control.declaration.iris",
                    "match": "\\b(function|variable|constant|global)\\b"
                },
                {
                    "name": "support.function.builtin.iris",
                    "match": "\\bterminal\\b"
                }
            ]
        },
        "types": {
            "patterns": [
                {
                    "name": "storage.type.primitive.iris",
                    "match": "\\b(integer|decimal|text|boolean|void)\\b"
                }
            ]
        },
        "booleans": {
            "patterns": [
                {
                    "name": "constant.language.boolean.iris",
                    "match": "\\b(true|false)\\b"
                }
            ]
        },
        "function-declarations": {
            "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.control.declaration.function.iris"
                },
                "2": {
                    "name": "entity.name.function.iris"
                },
                "3": {
                    "name": "storage.type.primitive.iris"
                }
            }
        },
        "function-calls": {
            "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.call.iris"
                }
            }
        },
        "variable-declarations": {
            "match": "\\b(variable|constant)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
            "captures": {
                "1": {
                    "name": "keyword.control.declaration.variable.iris"
                },
                "2": {
                    "name": "variable.other.declaration.iris"
                },
                "3": {
                    "name": "storage.type.primitive.iris"
                }
            }
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.iris",
                    "match": "(==|!=|<=|>=|<|>)"
                },
                {
                    "name": "keyword.operator.logical.iris",
                    "match": "(\\|\\||&&|!)"
                },
                {
                    "name": "keyword.operator.bitwise.iris",
                    "match": "(\\||&)"
                },
                {
                    "name": "keyword.operator.arithmetic.iris",
                    "match": "(\\+|-|\\*|/|%)"
                },
                {
                    "name": "keyword.operator.assignment.iris",
                    "match": "(=)"
                }
            ]
        }
    }
}