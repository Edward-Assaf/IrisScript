{
  "name": "irisscript-language-support",
  "publisher": "edward-assaf",
  "displayName": "IrisScript Runner and Syntax Checker",
  "description": "Language support, syntax highlighting, diagnostics, and runner for IrisScript",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Edward-Assaf/irisscript.git"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "irisscript",
        "aliases": [
          "IrisScript",
          "iris"
        ],
        "extensions": [
          ".iris"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "irisscript",
        "scopeName": "source.iris",
        "path": "./syntaxes/irisscript.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "irisscript.runFile",
        "title": "IrisScript: Run File",
        "icon": "$(play)"
      },
      {
        "command": "irisscript.buildFile",
        "title": "IrisScript: Compile File",
        "icon": "$(check)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "irisscript.runFile",
          "group": "navigation@1",
          "when": "resourceExtname == .iris"
        },
        {
          "command": "irisscript.buildFile",
          "group": "navigation@2",
          "when": "resourceExtname == .iris"
        }
      ]
    },
    "configuration": {
      "title": "IrisScript",
      "properties": {
        "irisscript.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to iris executable (iris.bat or iris). If empty, auto-detects from workspace or system PATH."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.80.0",
    "eslint": "^9.0.0"
  }
}